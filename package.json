{
  "name": "sui-blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Blog"
  },
  "scripts": {
    "dev": "astro dev --force --host",
    "seed:local": "rm -rf .wrangler/state/v3/d1 .wrangler/state/v3/r2 && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy --minify",
    "deploy:preview": "wrangler versions upload --minify",
    "cf-typegen": "wrangler types",
    "format": "biome format --write . && prettier --write '**/*.astro'",
    "format:check": "biome format . && prettier --check '**/*.astro'",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "type-check": "astro check",
    "knip": "knip"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/react": "^6.0.6",
    "@cf-wasm/og": "^0.5.0",
    "@emdash-cms/cloudflare": "^0.38.0",
    "astro": "^7.3.3",
    "astro-portabletext": "^0.13.0",
    "beautiful-mermaid": "^1.1.3",
    "emdash": "^0.38.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.4.15",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gray-matter": "^4.0.3",
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.135.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
