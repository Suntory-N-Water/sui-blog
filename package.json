{
  "name": "sui-blog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build && pagefind --site dist",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "icons": "node scripts/update-icons.ts",
    "format": "biome format --write . && prettier --write '**/*.astro'",
    "format:check": "biome format . && prettier --check '**/*.astro'",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "type-check": "astro check",
    "knip": "knip"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.11",
    "beautiful-mermaid": "^1.1.3",
    "satori": "^0.63.2",
    "shiki": "^4.6.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.5.14",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify/utils": "^3.1.7",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "gray-matter": "^4.0.3",
    "knip": "^6.45.1",
    "pagefind": "^1.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.161.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
