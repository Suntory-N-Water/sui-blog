---
import {
  getEmDashCollection,
  getTermsForEntries,
  getTaxonomyTermsWithCacheHint,
  getSiteSettings,
} from 'emdash';
import { Image } from 'emdash/ui';
import Base from '../layouts/Base.astro';
import PageShell from '../components/PageShell.astro';
import SectionBand from '../components/SectionBand.astro';
import PostIndex from '../components/PostIndex.astro';
import PostRow from '../components/PostRow.astro';
import TagIndex from '../components/TagIndex.astro';
import { getReadingTime } from '../utils/reading-time';
import { formatIndexDate, postDate } from '../utils/format-date';
import { resolveBlogSiteIdentity } from '../utils/site-identity';

const HOME_POST_LIMIT = 6;
const HOME_TAG_LIMIT = 12;

const [
  { entries: posts, cacheHint: postsCacheHint },
  { data: tags, cacheHint: tagsCacheHint },
  settings,
] = await Promise.all([
  getEmDashCollection('posts', {
    orderBy: { modified_time: 'desc' },
    limit: HOME_POST_LIMIT,
  }),
  getTaxonomyTermsWithCacheHint('tag', { includeCounts: true }),
  getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) {
  Astro.cache.set(postsCacheHint);
  Astro.cache.set(tagsCacheHint);
}

const leadPost = posts[0] ?? null;
const listPosts = posts.slice(1);

const tagsByEntry = await getTermsForEntries(
  'posts',
  posts.map((p) => p.data.id),
  'tag',
);

const leadTags = leadPost
  ? (tagsByEntry.get(leadPost.data.id) ?? []).map((t) => ({
      slug: t.slug,
      label: t.label,
    }))
  : [];

const topTags = tags
  .slice()
  .sort((a, b) => (b.count ?? 0) - (a.count ?? 0))
  .slice(0, HOME_TAG_LIMIT);
---

<Base title={siteTitle} description={siteTagline}>
  <PageShell>
    <header class='home-intro'>
      <h1 class='visually-hidden'>{siteTitle}</h1>
      <p>{siteTagline}</p>
    </header>

    {posts.length === 0 ? (
      <div class='empty-state'>
        <p>まだ記事がありません。</p>
        <a href='/_emdash/admin/content/posts/new' class='btn'>
          記事を作成
        </a>
      </div>
    ) : (
      <Fragment>
        {leadPost && (
          <article class='lead'>
            {leadPost.data.featured_image && (
              <Image
                image={leadPost.data.featured_image}
                alt=''
                width={34}
                height={34}
                class='lead-icon'
              />
            )}
            <div class='lead-date'>
              <time datetime={postDate(leadPost.data)?.toISOString()}>
                {formatIndexDate(postDate(leadPost.data))}
              </time>
            </div>
            <h2>
              <a href={`/blog/${leadPost.id}`}>{leadPost.data.title}</a>
            </h2>
            {leadPost.data.excerpt && (
              <p class='lead-excerpt'>{leadPost.data.excerpt}</p>
            )}
            <footer class='lead-foot'>
              <span class='lead-readtime'>
                {getReadingTime(leadPost.data.content)} 分
              </span>
              {leadTags.length > 0 && (
                <ul class='lead-tags' aria-label='タグ'>
                  {leadTags.map((tag) => (
                    <li>
                      <a href={`/tags/${tag.slug}`} class='tag'>
                        #{tag.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </footer>
          </article>
        )}

        {listPosts.length > 0 && (
          <section aria-label='最近の記事'>
            <SectionBand title='最近の記事' href='/blog' linkLabel='記事一覧' />
            <div class='index-wrap'>
              <PostIndex>
                {listPosts.map((post) => (
                  <PostRow
                    title={post.data.title}
                    href={`/blog/${post.id}`}
                    date={postDate(post.data)}
                    readingTime={getReadingTime(post.data.content)}
                    excerpt={post.data.excerpt}
                    icon={post.data.featured_image}
                    tags={(tagsByEntry.get(post.data.id) ?? []).map((t) => ({
                      slug: t.slug,
                      label: t.label,
                    }))}
                  />
                ))}
              </PostIndex>
            </div>
          </section>
        )}
      </Fragment>
    )}

    {topTags.length > 0 && (
      <section aria-label='タグから探す'>
        <SectionBand
          title='タグから探す'
          href='/tags'
          linkLabel='すべてのタグ'
        />
        <div class='index-wrap'>
          <TagIndex
            tags={topTags.map((tag) => ({
              slug: tag.slug,
              label: tag.label,
              count: tag.count,
            }))}
          />
        </div>
      </section>
    )}
  </PageShell>
</Base>

<style>
  .home-intro {
    padding: 64px 0 40px;
    max-width: 640px;
  }

  .home-intro p {
    font-size: 16px;
    line-height: 1.95;
    color: var(--color-text-secondary);
  }

  .index-wrap {
    max-width: var(--index-width);
  }

  .lead {
    max-width: var(--index-width);
    padding: 30px 0 34px;
    border-top: 1px solid var(--color-rule-strong);
    border-bottom: 1px solid var(--color-border);
  }

  .lead :global(.lead-icon) {
    width: 34px;
    height: 34px;
    object-fit: contain;
    margin-bottom: 14px;
  }

  .lead-date {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-text-secondary);
    margin-bottom: 8px;
    font-variant-numeric: tabular-nums;
  }

  .lead h2 {
    font-size: 28px;
    font-weight: var(--font-weight-display);
    line-height: 1.6;
    letter-spacing: var(--tracking-tight);
    max-width: 660px;
  }

  .lead h2 a {
    color: inherit;
  }

  .lead h2 a:hover {
    color: var(--color-brand);
  }

  .lead-excerpt {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.95;
    color: var(--color-text-secondary);
    max-width: 660px;
  }

  .lead-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin-top: 14px;
  }

  .lead-readtime {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .lead-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    list-style: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-brand);
  }

  .tag:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .empty-state {
    max-width: var(--index-width);
    padding: 40px 0 64px;
    border-top: 1px solid var(--color-border);
  }

  .empty-state p {
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  .btn {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid var(--color-rule-strong);
    color: var(--color-heading);
    font-size: 13.5px;
  }

  .btn:hover {
    color: var(--color-brand);
    border-color: var(--color-brand);
  }
</style>
