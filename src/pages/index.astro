---
import Base from '../layouts/Base.astro';
import PageShell from '../components/PageShell.astro';
import SectionBand from '../components/SectionBand.astro';
import PostIndex from '../components/PostIndex.astro';
import PostRow from '../components/PostRow.astro';
import PostIcon from '../components/PostIcon.astro';
import TagIndex from '../components/TagIndex.astro';
import { formatIndexDate } from '../utils/format-date';
import { AUTHOR_NAME, AUTHOR_SAME_AS, SITE_TAGLINE, SITE_TITLE, siteOrigin } from '../lib/site';
import {
  getPosts,
  HOME_POST_LIMIT,
  postPath,
  postTags,
  readingMinutes,
  summarizeTags,
  updatedAt,
} from '../lib/posts';

const HOME_TAG_LIMIT = 12;

const allPosts = await getPosts();
const posts = allPosts.slice(0, HOME_POST_LIMIT);
const siteTitle = SITE_TITLE;
const siteTagline = SITE_TAGLINE;

const leadPost = posts[0] ?? null;
const listPosts = posts.slice(1);
const leadTags = leadPost ? postTags(leadPost) : [];
const topTags = summarizeTags(allPosts).slice(0, HOME_TAG_LIMIT);

const origin = siteOrigin(Astro.site);
const personId = `${origin}/#person`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: AUTHOR_NAME,
      url: `${origin}/`,
      sameAs: AUTHOR_SAME_AS,
    },
    {
      '@type': 'Blog',
      '@id': `${origin}/#blog`,
      name: siteTitle,
      description: siteTagline,
      url: `${origin}/`,
      inLanguage: 'ja',
      author: { '@id': personId },
      isPartOf: { '@id': `${origin}/#website` },
      blogPost: posts.map((post) => ({
        '@type': 'BlogPosting',
        '@id': `${origin}${postPath(post)}#article`,
        headline: post.data.title,
        url: `${origin}${postPath(post)}`,
        datePublished: post.data.date.toISOString(),
        dateModified: updatedAt(post).toISOString(),
        author: { '@id': personId },
      })),
    },
  ],
};
---

<Base title={siteTitle} description={siteTagline} canonical={`${origin}/`} markdownHref='/index.md'>
  <script
    slot='head'
    type='application/ld+json'
    is:inline
    set:html={JSON.stringify(structuredData).replace(/</gu, '\\u003c')}
  />
  <PageShell>
    <header class='home-intro'>
      <h1 class='visually-hidden'>{siteTitle}</h1>
      <p>{siteTagline}</p>
    </header>

    {posts.length === 0 ? (
      <div class='empty-state'>
        <p>まだ記事がありません。</p>
      </div>
    ) : (
      <Fragment>
        {leadPost && (
          <article class='lead'>
            <PostIcon iconUrl={leadPost.data.icon_url} class='lead-icon' />
            <div class='lead-date'>
              <time datetime={leadPost.data.date.toISOString()}>
                {formatIndexDate(leadPost.data.date)}
              </time>
            </div>
            <h2>
              <a href={postPath(leadPost)}>{leadPost.data.title}</a>
            </h2>
            {leadPost.data.description && <p class='lead-excerpt'>{leadPost.data.description}</p>}
            <footer class='lead-foot'>
              <span class='lead-readtime'>{readingMinutes(leadPost.body)} 分</span>
              {leadTags.length > 0 && (
                <ul class='lead-tags' aria-label='タグ'>
                  {leadTags.map((tag) => (
                    <li>
                      <a href={`/tags/${tag.slug}`} class='tag'>
                        #{tag.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </footer>
          </article>
        )}

        {listPosts.length > 0 && (
          <section aria-label='最近の記事'>
            <SectionBand title='最近の記事' href='/posts' linkLabel='記事一覧' />
            <div class='index-wrap'>
              <PostIndex>
                {listPosts.map((post) => (
                  <PostRow
                    title={post.data.title}
                    href={postPath(post)}
                    date={post.data.date}
                    readingTime={readingMinutes(post.body)}
                    excerpt={post.data.description}
                    iconUrl={post.data.icon_url}
                    tags={postTags(post)}
                  />
                ))}
              </PostIndex>
            </div>
          </section>
        )}
      </Fragment>
    )}

    {topTags.length > 0 && (
      <section aria-label='タグから探す'>
        <SectionBand title='タグから探す' href='/tags' linkLabel='すべてのタグ' />
        <div class='index-wrap'>
          <TagIndex tags={topTags} />
        </div>
      </section>
    )}
  </PageShell>
</Base>

<style>
  .home-intro {
    padding: 64px 0 40px;
    max-width: 640px;
  }

  .home-intro p {
    font-size: 16px;
    line-height: 1.95;
    color: var(--color-text-secondary);
  }

  .index-wrap {
    max-width: var(--index-width);
  }

  .lead {
    max-width: var(--index-width);
    padding: 30px 0 34px;
    border-top: var(--rule-width) solid var(--color-rule-strong);
    border-bottom: var(--rule-width) solid var(--color-border);
  }

  .lead :global(.lead-icon) {
    width: 34px;
    height: 34px;
    margin-bottom: 14px;
  }

  .lead-date {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-text-secondary);
    margin-bottom: 8px;
    font-variant-numeric: tabular-nums;
  }

  .lead h2 {
    font-size: 28px;
    font-weight: var(--font-weight-display);
    line-height: 1.6;
    letter-spacing: var(--tracking-tight);
    max-width: 660px;
  }

  .lead h2 a {
    color: inherit;
  }

  .lead h2 a:hover {
    color: var(--color-brand);
  }

  .lead-excerpt {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.95;
    color: var(--color-text-secondary);
    max-width: 660px;
  }

  .lead-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin-top: 14px;
  }

  .lead-readtime {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .lead-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    list-style: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-brand);
  }

  .tag:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .empty-state {
    max-width: var(--index-width);
    padding: 40px 0 64px;
    border-top: var(--rule-width) solid var(--color-border);
  }

  .empty-state p {
    color: var(--color-text-secondary);
  }
</style>
