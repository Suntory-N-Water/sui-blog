---
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import PostArchive from '../../components/PostArchive.astro';
import { getPosts, PER_PAGE } from '../../lib/posts';

const posts = await getPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / PER_PAGE));
---

<Base title='記事一覧' description='すべての記事の一覧' markdownHref='/posts.md'>
  <PageShell>
    <PostArchive posts={posts.slice(0, PER_PAGE)} page={1} totalPages={totalPages} />
  </PageShell>
</Base>
