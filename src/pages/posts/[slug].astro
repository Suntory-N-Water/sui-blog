---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionBand from '../../components/SectionBand.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import PostIndex from '../../components/PostIndex.astro';
import PostRow from '../../components/PostRow.astro';
import PostIcon from '../../components/PostIcon.astro';
import {
  getPosts,
  type Post,
  postPath,
  postTags,
  readingMinutes,
  relatedPosts,
  updatedAt,
} from '../../lib/posts';
import { AUTHOR_NAME, siteOrigin } from '../../lib/site';
import { formatIndexDate } from '../../utils/format-date';
import '../../styles/article.css';

export const getStaticPaths = (async () => {
  const relatedCount = 3;
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, posts, relatedCount) },
  }));
}) satisfies GetStaticPaths;

const { post, related } = Astro.props as { post: Post; related: Post[] };
const { Content } = await render(post);

const origin = siteOrigin(Astro.site);
const canonical = `${origin}${postPath(post)}`;
const authorNames = AUTHOR_NAME;
const readingTime = readingMinutes(post.body);
const tags = postTags(post);
const publishDate = formatIndexDate(post.data.date);
const publishDateTime = post.data.date.toISOString();
---

<Base
  title={post.data.title}
  description={post.data.description}
  image={`${origin}/posts/ogp/${post.id}.png`}
  canonical={canonical}
  type='article'
  publishedTime={publishDateTime}
  modifiedTime={updatedAt(post).toISOString()}
  markdownHref={`${postPath(post)}.md`}
>
  <PageShell>
    <Breadcrumbs
      items={[
        { label: 'ホーム', href: '/' },
        { label: '記事一覧', href: '/posts' },
        { label: post.data.title, href: postPath(post) },
      ]}
    />
    <article data-pagefind-body>
      <header class='article-head'>
        <PostIcon iconUrl={post.data.icon_url} class='head-icon' />
        <h1 class='title' data-pagefind-meta='title'>
          {post.data.title}
        </h1>
        {post.data.description && <p class='summary'>{post.data.description}</p>}
      </header>

      <div class='article-grid'>
        <div class='meta-col'>
          <div class='sticky'>
            <dl class='meta-list'>
              {authorNames && (
                <div class='meta-row'>
                  <dt>著者</dt>
                  <dd class='nm'>{authorNames}</dd>
                </div>
              )}
              {publishDate && (
                <div class='meta-row'>
                  <dt>公開日</dt>
                  <dd>
                    <time datetime={publishDateTime}>{publishDate}</time>
                  </dd>
                </div>
              )}
              <div class='meta-row'>
                <dt>読了まで</dt>
                <dd>{readingTime} 分</dd>
              </div>
            </dl>
            {tags.length > 0 && (
              <ul class='meta-tags' aria-label='タグ' data-pagefind-ignore>
                {tags.map((t) => (
                  <li>
                    <a href={`/tags/${t.slug}`} class='tag'>
                      #{t.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>

        <div class='article-main'>
          <div class='article-mobile' data-pagefind-ignore>
            <p class='mobile-meta'>
              {authorNames && <Fragment>{authorNames} / </Fragment>}
              {publishDate && (
                <Fragment>
                  <time datetime={publishDateTime}>{publishDate}</time> /{' '}
                </Fragment>
              )}
              {readingTime} 分
            </p>
            <details class='mobile-toc' id='mobile-toc'>
              <summary>目次</summary>
              <nav class='toc' aria-label='目次'>
                <ul id='mobile-toc-list'></ul>
              </nav>
            </details>
          </div>

          <div class='prose'>
            <Content />
          </div>

          <footer class='article-foot' data-pagefind-ignore>
            {tags.length > 0 && (
              <ul class='foot-tags' aria-label='タグ'>
                {tags.map((t) => (
                  <li>
                    <a href={`/tags/${t.slug}`} class='tag'>
                      #{t.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            <div class='foot-actions'>
              <ShareLinks url={canonical} title={post.data.title} />
              <a href={`${postPath(post)}.md`} class='btn'>
                この記事を Markdown で取得
              </a>
            </div>
          </footer>

          {related.length > 0 && (
            <aside class='more' aria-label='関連する記事' data-pagefind-ignore>
              <SectionBand title='関連する記事' flush />
              <PostIndex>
                {related.map((p) => (
                  <PostRow
                    title={p.data.title}
                    href={postPath(p)}
                    date={p.data.date}
                    readingTime={readingMinutes(p.body)}
                    iconUrl={p.data.icon_url}
                    tags={postTags(p)}
                  />
                ))}
              </PostIndex>
            </aside>
          )}
        </div>

        <aside class='toc-col' id='toc-col' data-pagefind-ignore>
          <div class='sticky'>
            <nav class='toc' aria-label='目次'>
              <div class='lbl' aria-hidden='true'>
                目次
              </div>
              <ul id='toc-list'></ul>
            </nav>
          </div>
        </aside>
      </div>
    </article>
  </PageShell>

  <script>
    function buildToc() {
      const content = document.querySelector('.prose');
      const desktopList = document.getElementById('toc-list');
      const mobileList = document.getElementById('mobile-toc-list');
      const tocCol = document.getElementById('toc-col');
      const mobileToc = document.getElementById('mobile-toc');
      if (!content || !desktopList || !mobileList) return;

      const headings = content.querySelectorAll(':scope > h2, :scope > h3');
      if (headings.length === 0) {
        if (tocCol) tocCol.style.display = 'none';
        if (mobileToc) mobileToc.style.display = 'none';
        return;
      }

      headings.forEach((heading, index) => {
        if (!heading.id) {
          heading.id = `heading-${index}`;
        }

        const nest = heading.tagName === 'H3';
        const li = document.createElement('li');
        if (nest) li.className = 'nest';

        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent;

        li.appendChild(link);
        desktopList.appendChild(li);
        mobileList.appendChild(li.cloneNode(true));
      });

      const links = document.querySelectorAll('.toc a');
      let currentId = '';

      function syncActive() {
        let activeId = headings[0].id;
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top > 100) {
            break;
          }
          activeId = heading.id;
        }
        if (activeId === currentId) {
          return;
        }
        currentId = activeId;
        links.forEach((a) => {
          a.classList.toggle('active', a.getAttribute('href') === `#${activeId}`);
        });
      }

      let queued = false;
      window.addEventListener(
        'scroll',
        () => {
          if (queued) {
            return;
          }
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            syncActive();
          });
        },
        { passive: true },
      );
      syncActive();
    }

    buildToc();

    const COPIED_DURATION_MS = 2000;

    document.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('.code-copy');
      const pre = button?.parentElement?.querySelector('pre');
      if (!button || !pre) {
        return;
      }
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
      } catch {
        return;
      }
      button.classList.add('copied');
      button.setAttribute('aria-label', 'コピーしました');
      window.setTimeout(() => {
        button.classList.remove('copied');
        button.setAttribute('aria-label', 'コードをコピー');
      }, COPIED_DURATION_MS);
    });
  </script>
</Base>

<style>
  .article-head {
    display: grid;
    grid-template-columns:
      var(--meta-col-width) minmax(0, var(--content-width))
      var(--gutter-width);
    gap: 0 48px;
    padding: 52px 0 30px;
    border-bottom: var(--rule-width) solid var(--color-rule-strong);
  }

  .article-head :global(.head-icon) {
    grid-column: 2;
    justify-self: start;
    width: 40px;
    height: 40px;
    margin-bottom: 18px;
  }

  .article-head .title {
    grid-column: 2 / -1;
    font-size: 30px;
    font-weight: var(--font-weight-display);
    line-height: 1.6;
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
  }

  .article-head .summary {
    grid-column: 2;
    margin-top: 18px;
    font-size: 15px;
    line-height: 1.95;
    color: var(--color-text-secondary);
  }

  .article-grid {
    display: grid;
    grid-template-columns:
      var(--meta-col-width) minmax(0, var(--content-width))
      var(--gutter-width);
    gap: 48px;
    padding: 40px 0 96px;
  }

  .sticky {
    position: sticky;
    top: 128px;
  }

  .meta-list {
    margin: 0;
  }

  .meta-row {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 10px;
    padding: 7px 0;
    border-bottom: var(--rule-width) solid var(--color-border);
    font-size: 13px;
  }

  .meta-row dt {
    margin: 0;
    color: var(--color-muted);
  }

  .meta-row dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-text-secondary);
  }

  .meta-row dd.nm {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-heading);
  }

  .meta-tags {
    padding-top: 12px;
    list-style: none;
  }

  .meta-tags .tag,
  .foot-tags .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-brand);
  }

  .meta-tags .tag {
    display: block;
    padding: 2px 0;
  }

  .article-main {
    min-width: 0;
  }

  .article-mobile {
    display: none;
    margin-bottom: 32px;
  }

  .mobile-meta {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-text-secondary);
  }

  .mobile-toc summary {
    font-size: 13.5px;
    color: var(--color-heading);
    cursor: pointer;
    padding: 8px 0;
    border-bottom: var(--rule-width) solid var(--color-border);
  }

  .mobile-toc .toc {
    margin-top: 10px;
  }

  .prose {
    font-size: 16px;
    line-height: 2.05;
  }

  .prose > :global(p) {
    margin-bottom: 26px;
  }

  .prose :global(h2) {
    font-size: 19px;
    font-weight: var(--font-weight-heading);
    margin: 52px 0 20px;
    padding-top: 14px;
    border-top: var(--rule-width) solid var(--color-rule-strong);
    scroll-margin-top: 24px;
  }

  .prose :global(h3) {
    font-size: 16.5px;
    font-weight: var(--font-weight-heading);
    margin: 36px 0 14px;
    scroll-margin-top: 24px;
  }

  .prose :global(a) {
    color: var(--color-brand);
    border-bottom: 1px solid var(--color-brand-underline);
    text-decoration: none;
  }

  .prose :global(a:has(> .link-favicon)) {
    overflow-wrap: anywhere;
  }

  .prose :global(img.link-favicon) {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin: 0 0.3em 0 0;
    vertical-align: -0.125em;
    border-radius: 50%;
    object-fit: cover;
  }

  .prose :global(mark) {
    background: var(--color-mark);
    color: inherit;
    padding: 0 2px;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--color-brand);
    border: 1px solid var(--color-border);
    padding: 0 5px;
    overflow-wrap: anywhere;
  }

  .prose :global(pre code) {
    border: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
    overflow-wrap: normal;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 26px;
    padding-left: 20px;
  }

  .prose :global(li) {
    margin-bottom: 4px;
  }

  .prose :global(blockquote) {
    margin: 0 0 26px;
    padding-left: 20px;
    border-left: var(--rule-width-accent) solid var(--color-rule-strong);
    color: var(--color-text-secondary);
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(img:not(.link-favicon)) {
    margin: 26px 0;
  }

  .prose :global(hr) {
    margin: 40px 0;
    border: none;
    border-top: var(--rule-width) solid var(--color-border);
  }

  .prose :global(sup) {
    font-size: 0.7em;
    line-height: 0;
  }

  .prose :global(.footnotes) {
    margin-top: 52px;
    padding-top: 24px;
    border-top: var(--rule-width) solid var(--color-rule-strong);
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .prose :global(.footnotes h2) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
    font-size: 14px;
    color: var(--color-muted);
  }

  .prose :global(.footnotes li) {
    scroll-margin-top: 96px;
  }

  .prose :global(.footnotes li:target),
  .prose :global([data-footnote-ref]:target) {
    background: var(--color-mark);
  }

  .prose :global([data-footnote-ref]) {
    scroll-margin-top: 96px;
    border-bottom: none;
  }

  .prose :global([data-footnote-backref]) {
    margin-left: 6px;
    border-bottom: none;
  }

  .article-foot {
    max-width: var(--content-width);
    margin: 60px 0 0;
    padding-top: 24px;
    border-top: var(--rule-width) solid var(--color-rule-strong);
  }

  .foot-tags {
    display: none;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-bottom: 20px;
    list-style: none;
  }

  .foot-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 24px;
  }

  .btn {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid var(--color-rule-strong);
    color: var(--color-heading);
    font-size: 13.5px;
    border-radius: 0;
  }

  .btn:hover {
    color: var(--color-brand);
    border-color: var(--color-brand);
  }

  .more {
    padding: 56px 0 0;
  }

  .toc {
    font-size: 13px;
  }

  .toc .lbl {
    font-size: 12px;
    color: var(--color-muted);
    padding-bottom: 7px;
    border-bottom: var(--rule-width) solid var(--color-border);
  }

  .toc :global(ul) {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }

  .toc :global(a) {
    display: block;
    padding: 5px 0 5px 12px;
    color: var(--color-heading);
    line-height: 1.65;
    border-left: var(--rule-width-accent) solid var(--color-border);
  }

  .toc :global(li.nest a) {
    padding-left: 26px;
    font-size: 12.5px;
    color: var(--color-text-secondary);
  }

  .toc :global(a:hover) {
    background: var(--color-surface);
    border-left-color: var(--color-rule-strong);
  }

  .toc :global(a.active) {
    background: var(--color-surface);
    color: var(--color-brand);
    border-left-color: var(--color-brand);
  }

  @media (max-width: 1060px) {
    .article-head,
    .article-grid {
      grid-template-columns: minmax(0, var(--content-width));
      gap: 0;
    }

    .article-head :global(.head-icon),
    .article-head .title,
    .article-head .summary {
      grid-column: 1;
    }

    .meta-col,
    .toc-col {
      display: none;
    }

    .article-mobile {
      display: block;
    }

    .foot-tags {
      display: flex;
    }
  }

  @media (max-width: 600px) {
    .article-head .title {
      font-size: 24px;
    }
  }
</style>
