---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PageShell from '../../../components/PageShell.astro';
import PostArchive from '../../../components/PostArchive.astro';
import { getPosts, PER_PAGE } from '../../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const totalPages = Math.ceil(posts.length / PER_PAGE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        page,
        totalPages,
        posts: posts.slice((page - 1) * PER_PAGE, page * PER_PAGE),
      },
    };
  });
}) satisfies GetStaticPaths;

const { page, totalPages, posts } = Astro.props;
---

<Base title={`記事一覧 - ${page} ページ目`} description={`すべての記事の一覧(${page} ページ目)`}>
  <PageShell>
    <PostArchive posts={posts} page={page} totalPages={totalPages} />
  </PageShell>
</Base>
