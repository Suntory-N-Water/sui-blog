---
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import ArchiveHead from '../../components/ArchiveHead.astro';
import TagIndex from '../../components/TagIndex.astro';
import { getPosts, summarizeTags } from '../../lib/posts';

const tags = summarizeTags(await getPosts());
---

<Base title='タグ一覧' description='記事のタグ一覧'>
  <PageShell>
    <ArchiveHead title='タグ一覧' sub={`${tags.length} タグ / 記事数の多い順`} />
    <div class='tag-index-wrap'>
      <TagIndex tags={tags} />
    </div>
  </PageShell>
</Base>

<style>
  .tag-index-wrap {
    max-width: var(--index-width);
  }
</style>
