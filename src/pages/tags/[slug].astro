---
import {
  getTerm,
  getEmDashCollection,
  getTermsForEntries,
  decodeSlug,
} from 'emdash';
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import ArchiveHead from '../../components/ArchiveHead.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import BlogRow from '../../components/BlogRow.astro';
import { getReadingTime } from '../../utils/reading-time';
import { blogDate } from '../../utils/format-date';

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm('tag', slug, { includeCounts: false }) : null;

if (!term) {
  return Astro.redirect('/404');
}

const { entries: blogs, cacheHint } = await getEmDashCollection('blogs', {
  where: { tag: term.slug },
  orderBy: { modified_time: 'desc' },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
  'blogs',
  blogs.map((p) => p.data.id),
  'tag',
);
const filteredBlogs = blogs.map((blog) => ({
  blog,
  tags: tagsByEntry.get(blog.data.id) ?? [],
}));
---

<Base
  title={`#${term.label} の記事`}
  description={`「${term.label}」タグが付いた記事の一覧`}
>
  <PageShell>
    <ArchiveHead title={`#${term.label}`} sub={`${filteredBlogs.length} 件`} />

    {filteredBlogs.length === 0 ? (
      <p class='no-blogs'>このタグの記事はまだありません。</p>
    ) : (
      <BlogIndex>
        {filteredBlogs.map(({ blog, tags }) => (
          <BlogRow
            title={blog.data.title}
            href={`/blog/${blog.id}`}
            date={blogDate(blog.data)}
            readingTime={getReadingTime(blog.data.content)}
            excerpt={blog.data.excerpt}
            icon={blog.data.featured_image}
            tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
            headingLevel={2}
          />
        ))}
      </BlogIndex>
    )}
  </PageShell>
</Base>

<style>
  .no-blogs {
    max-width: var(--index-width);
    padding: var(--spacing-8) 0;
    color: var(--color-muted);
    border-top: var(--rule-width) solid var(--color-border);
  }
</style>
