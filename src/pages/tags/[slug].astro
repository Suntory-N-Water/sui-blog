---
import {
  getTerm,
  getEmDashCollection,
  getTermsForEntries,
  decodeSlug,
} from 'emdash';
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import ArchiveHead from '../../components/ArchiveHead.astro';
import PostIndex from '../../components/PostIndex.astro';
import PostRow from '../../components/PostRow.astro';
import { getReadingTime } from '../../utils/reading-time';
import { postDate } from '../../utils/format-date';

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm('tag', slug, { includeCounts: false }) : null;

if (!term) {
  return Astro.redirect('/404');
}

const { entries: posts, cacheHint } = await getEmDashCollection('posts', {
  where: { tag: term.slug },
  orderBy: { modified_time: 'desc' },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
  'posts',
  posts.map((p) => p.data.id),
  'tag',
);
const filteredPosts = posts.map((post) => ({
  post,
  tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base
  title={`#${term.label} の記事`}
  description={`「${term.label}」タグが付いた記事の一覧`}
>
  <PageShell>
    <ArchiveHead title={`#${term.label}`} sub={`${filteredPosts.length} 件`} />

    {filteredPosts.length === 0 ? (
      <p class='no-posts'>このタグの記事はまだありません。</p>
    ) : (
      <PostIndex>
        {filteredPosts.map(({ post, tags }) => (
          <PostRow
            title={post.data.title}
            href={`/blog/${post.id}`}
            date={postDate(post.data)}
            readingTime={getReadingTime(post.data.content)}
            excerpt={post.data.excerpt}
            icon={post.data.featured_image}
            tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
            headingLevel={2}
          />
        ))}
      </PostIndex>
    )}
  </PageShell>
</Base>

<style>
  .no-posts {
    max-width: var(--index-width);
    padding: var(--spacing-8) 0;
    color: var(--color-muted);
    border-top: 1px solid var(--color-border);
  }
</style>
