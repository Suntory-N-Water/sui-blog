---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArchiveHead from '../../components/ArchiveHead.astro';
import PostIndex from '../../components/PostIndex.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, postPath, postTags, readingMinutes, summarizeTags } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return summarizeTags(posts).map((tag) => ({
    params: { slug: tag.slug },
    props: {
      label: tag.label,
      posts: posts.filter((post) => postTags(post).some(({ slug }) => slug === tag.slug)),
    },
  }));
}) satisfies GetStaticPaths;

const { label, posts } = Astro.props;
---

<Base title={`#${label} の記事`} description={`「${label}」タグが付いた記事の一覧`}>
  <PageShell>
    <Breadcrumbs
      items={[
        { label: 'ホーム', href: '/' },
        { label: 'タグ一覧', href: '/tags' },
        { label: `#${label}`, href: Astro.url.pathname },
      ]}
    />
    <ArchiveHead title={`#${label}`} sub={`${posts.length} 件`} />

    <PostIndex>
      {posts.map((post) => (
        <PostRow
          title={post.data.title}
          href={postPath(post)}
          date={post.data.date}
          readingTime={readingMinutes(post.body)}
          excerpt={post.data.description}
          iconUrl={post.data.icon_url}
          tags={postTags(post)}
          headingLevel={2}
        />
      ))}
    </PostIndex>
  </PageShell>
</Base>
