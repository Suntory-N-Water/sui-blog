---
import Base from '../layouts/Base.astro';
import PageShell from '../components/PageShell.astro';
---

<Base title='ページが見つかりません'>
  <PageShell>
    <div class='not-found'>
      <p class='not-found-code'>404</p>
      <p class='not-found-desc'>お探しのページは見つかりませんでした。</p>
      <a href='/' class='not-found-link'>
        ホームに戻る
      </a>
    </div>
  </PageShell>
</Base>

<style>
  .not-found {
    padding: 96px 0;
  }

  .not-found-code {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-muted);
    margin-bottom: 16px;
  }

  .not-found-desc {
    font-size: 16px;
    color: var(--color-text-secondary);
    margin-bottom: 24px;
  }

  .not-found-link {
    color: var(--color-brand);
    border-bottom: 1px solid var(--color-brand-underline);
  }
</style>
