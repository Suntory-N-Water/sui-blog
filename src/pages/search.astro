---
import Base from '../layouts/Base.astro';
import PageShell from '../components/PageShell.astro';
import ArchiveHead from '../components/ArchiveHead.astro';
---

<Base title='記事を検索' description='ブログ記事を検索する' robots='noindex'>
  <PageShell>
    <div class='search-col'>
      <ArchiveHead title='記事を検索' />

      <search>
        <form method='get' action='/search' class='search-form' data-search-page-form>
          <input
            type='search'
            name='q'
            placeholder='キーワードで検索'
            aria-label='検索キーワード'
            class='search-input'
            data-search-page-input
          />
          <button type='submit' class='search-button'>
            検索
          </button>
        </form>
      </search>

      <p class='search-summary' role='status' data-search-page-status>
        キーワードを入力して記事を検索してください。
      </p>
      <ul class='search-results' data-search-page-results></ul>
    </div>
  </PageShell>
</Base>

<script>
  import { searchPosts } from '../scripts/pagefind';

  const RESULT_LIMIT = 30;

  const input = document.querySelector<HTMLInputElement>('[data-search-page-input]');
  const status = document.querySelector<HTMLElement>('[data-search-page-status]');
  const list = document.querySelector<HTMLElement>('[data-search-page-results]');
  const query = new URLSearchParams(window.location.search).get('q')?.trim() ?? '';

  if (input && status && list && query) {
    input.value = query;
    status.textContent = '検索しています';
    searchPosts(query, RESULT_LIMIT)
      .then((hits) => {
        status.textContent =
          hits.length > 0
            ? `「${query}」の検索結果 ${hits.length} 件`
            : `「${query}」に一致する記事が見つかりませんでした。`;
        list.replaceChildren(
          ...hits.map((hit) => {
            const item = document.createElement('li');
            item.className = 'search-result';
            const link = document.createElement('a');
            link.className = 'result-link';
            link.href = hit.url;
            const title = document.createElement('h2');
            title.className = 'result-title';
            title.textContent = hit.title;
            const snippet = document.createElement('p');
            snippet.className = 'result-snippet';
            snippet.innerHTML = hit.excerpt;
            link.append(title, snippet);
            item.append(link);
            return item;
          }),
        );
      })
      .catch(() => {
        status.textContent = '検索できませんでした。時間をおいて再度お試しください。';
      });
  }
</script>

<style>
  .search-col {
    max-width: var(--index-width);
  }

  .search-form {
    display: flex;
    gap: 12px;
    margin: 24px 0 8px;
  }

  .search-input {
    flex: 1;
    padding: 8px 12px;
    font-size: 14px;
    font-family: var(--font-body);
    border: 1px solid var(--color-border);
    border-radius: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-brand);
  }

  .search-button {
    padding: 8px 16px;
    border: 1px solid var(--color-rule-strong);
    color: var(--color-heading);
    font-size: 13.5px;
    font-family: var(--font-body);
    background: none;
    cursor: pointer;
  }

  .search-button:hover {
    color: var(--color-brand);
    border-color: var(--color-brand);
  }

  .search-summary {
    padding: 20px 0;
    color: var(--color-muted);
    border-top: var(--rule-width) solid var(--color-border);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .search-results :global(.search-result) {
    padding: 20px 0;
    border-top: var(--rule-width) solid var(--color-border);
  }

  .search-results :global(.result-link) {
    display: block;
    color: inherit;
  }

  .search-results :global(.result-title) {
    font-size: 16.5px;
    font-weight: var(--font-weight-heading);
    line-height: 1.7;
  }

  .search-results :global(.result-link:hover .result-title) {
    color: var(--color-brand);
  }

  .search-results :global(.result-snippet) {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.85;
    color: var(--color-text-secondary);
  }

  .search-results :global(.result-snippet mark) {
    background: var(--color-mark);
    color: inherit;
    padding: 0 2px;
  }
</style>
