---
import { getEmDashCollection, getTermsForEntries } from 'emdash';
import Base from '../../../layouts/Base.astro';
import PageShell from '../../../components/PageShell.astro';
import PostArchive from '../../../components/PostArchive.astro';

const PER_PAGE = 20;

const pageParam = Astro.params.page ?? '';
if (!/^[1-9]\d*$/.test(pageParam)) {
  return Astro.redirect('/404');
}

const page = Number(pageParam);

if (page === 1) {
  return Astro.redirect('/blog', 301);
}

const {
  entries: posts,
  hasMore,
  cacheHint,
  error,
} = await getEmDashCollection('posts', {
  limit: PER_PAGE,
  offset: (page - 1) * PER_PAGE,
  orderBy: { modified_time: 'desc' },
});

if (error) {
  return new Response(null, { status: 500 });
}

if (posts.length === 0) {
  return Astro.redirect('/404');
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
  'posts',
  posts.map((p) => p.data.id),
  'tag',
);
---

<Base
  title={`記事一覧 - ${page} ページ目`}
  description={`すべての記事の一覧(${page} ページ目)`}
>
  <PageShell>
    <PostArchive
      posts={posts}
      tagsByEntry={tagsByEntry}
      page={page}
      hasMore={!!hasMore}
    />
  </PageShell>
</Base>
