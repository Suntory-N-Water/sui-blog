---
import { getEmDashCollection, getTermsForEntries } from 'emdash';
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import { countPublishedBlogs } from '../../lib/blog-index';
import BlogArchive from '../../components/BlogArchive.astro';

const PER_PAGE = 10;
const page = 1;

const [{ entries: blogs, hasMore, cacheHint, error }, total] =
  await Promise.all([
    getEmDashCollection('blogs', {
      limit: PER_PAGE,
      offset: (page - 1) * PER_PAGE,
      orderBy: { modified_time: 'desc' },
    }),
    countPublishedBlogs(),
  ]);

if (error) {
  return new Response(null, { status: 500 });
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const totalPages = Math.max(
  Math.ceil(total / PER_PAGE),
  hasMore ? page + 1 : page,
);

const tagsByEntry = await getTermsForEntries(
  'blogs',
  blogs.map((p) => p.data.id),
  'tag',
);
---

<Base title='記事一覧' description='すべての記事の一覧'>
  <PageShell>
    <BlogArchive
      blogs={blogs}
      tagsByEntry={tagsByEntry}
      page={page}
      totalPages={totalPages}
    />
  </PageShell>
</Base>
