---
import { getEmDashCollection, getTermsForEntries } from 'emdash';
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import ArchiveHead from '../../components/ArchiveHead.astro';
import PostIndex from '../../components/PostIndex.astro';
import PostRow from '../../components/PostRow.astro';
import { getReadingTime } from '../../utils/reading-time';
import { formatYearMonth, getYear, postDate } from '../../utils/format-date';

const { entries: posts, cacheHint } = await getEmDashCollection('posts', {
  orderBy: { modified_time: 'desc' },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
  'posts',
  posts.map((p) => p.data.id),
  'tag',
);

const yearGroups = new Map<string, typeof posts>();
for (const post of posts) {
  const year = getYear(postDate(post.data)) ?? '不明';
  const group = yearGroups.get(year);
  if (group) {
    group.push(post);
  } else {
    yearGroups.set(year, [post]);
  }
}

const lastPost = posts.at(-1);
const firstPost = posts[0];
const oldest = lastPost ? formatYearMonth(postDate(lastPost.data)) : null;
const newest = firstPost ? formatYearMonth(postDate(firstPost.data)) : null;
const dateRange =
  oldest && newest
    ? oldest === newest
      ? oldest
      : `${oldest} — ${newest}`
    : null;
const sub = dateRange
  ? `${posts.length} 件 / ${dateRange}`
  : `${posts.length} 件`;
---

<Base title='記事一覧' description='すべての記事の一覧'>
  <PageShell>
    <ArchiveHead title='記事一覧' sub={sub} />

    {posts.length === 0 ? (
      <p class='empty'>まだ記事がありません。</p>
    ) : (
      Array.from(yearGroups.entries()).map(([year, yearPosts]) => (
        <section class='year-group'>
          <div class='year'>
            <h2>{year}</h2>
            <span>{yearPosts.length} 件</span>
          </div>
          <PostIndex topRule={false}>
            {yearPosts.map((post) => (
              <PostRow
                title={post.data.title}
                href={`/blog/${post.id}`}
                date={postDate(post.data)}
                readingTime={getReadingTime(post.data.content)}
                icon={post.data.featured_image}
                tags={(tagsByEntry.get(post.data.id) ?? []).map((t) => ({
                  slug: t.slug,
                  label: t.label,
                }))}
              />
            ))}
          </PostIndex>
        </section>
      ))
    )}
  </PageShell>
</Base>

<style>
  .year-group {
    max-width: var(--index-width);
  }

  .year {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 34px 0 6px;
    border-bottom: 1px solid var(--color-rule-strong);
  }

  .year h2 {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
  }

  .year span {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    max-width: var(--index-width);
    padding: 40px 0;
    color: var(--color-text-secondary);
    border-top: 1px solid var(--color-border);
  }
</style>
