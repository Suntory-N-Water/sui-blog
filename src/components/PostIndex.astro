---
interface Props {
  topRule?: boolean;
}

const { topRule = true } = Astro.props;
---

<ul class:list={['post-index', topRule && 'has-top-rule']}>
  <slot />
</ul>

<style>
  .post-index {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--index-width);
  }

  .has-top-rule {
    border-top: var(--rule-width) solid var(--color-border);
  }
</style>
