---
import { Code } from 'astro:components';
import type { ComponentProps } from 'astro/types';
import { bundledLanguagesInfo } from 'shiki/langs';
import Mermaid from './Mermaid.astro';

const SUPPORTED_LANGUAGES = new Set([
  'plaintext',
  'plain',
  'text',
  'txt',
  'ansi',
  ...bundledLanguagesInfo.flatMap((info) => [info.id, ...(info.aliases ?? [])]),
]);

export interface Props {
  node: {
    _type: 'code';
    _key: string;
    code: string;
    language?: string;
    filename?: string;
  };
}

const { node } = Astro.props;

const code = node?.code ?? '';
const language = node?.language?.toLowerCase();
const filename = node?.filename;

const isMermaid = language === 'mermaid';

const lang = (
  language && SUPPORTED_LANGUAGES.has(language) ? language : 'plaintext'
) as ComponentProps<typeof Code>['lang'];
---

{code &&
  (isMermaid ? (
    <Mermaid code={code} />
  ) : (
    <div class='code-block'>
      {filename && <div class='code-block-filename'>{filename}</div>}
      <Code code={code} lang={lang} theme='dark-plus' />
    </div>
  ))}

<style>
  .code-block {
    margin: 0 0 26px;
  }

  .code-block-filename {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 8px 18px;
    background: var(--color-code-bar);
    color: var(--color-code-label);
    border-bottom: 1px solid var(--color-code-rule);
  }

  .code-block :global(pre.astro-code) {
    margin: 0;
    padding: 16px 18px;
    background: var(--color-code-bg) !important;
    border-radius: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.9;
  }

  .code-block :global(pre.astro-code code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }
</style>
