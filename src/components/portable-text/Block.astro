---
import type { BlockProps } from 'astro-portabletext/types';
import { emdashComponents } from 'emdash/ui';
import { alertKind } from '../../lib/github-alert';
import { bareLinkHref } from '../../lib/link-card';
import Alert from './Alert.astro';
import LinkCard from './LinkCard.astro';

const props = Astro.props as BlockProps;
const href = bareLinkHref(props.node);
const kind =
  props.node.style === 'blockquote' ? alertKind(props.node) : null;
const EmDashBlock = emdashComponents.block;
---

{href ? <LinkCard url={href} /> : kind ? <Alert kind={kind} blocks={[]} /> : (
  <EmDashBlock {...props}>
    <slot />
  </EmDashBlock>
)}
