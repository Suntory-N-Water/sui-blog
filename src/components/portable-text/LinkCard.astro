---
import { getEmDashEntry, type MediaValue } from 'emdash';
import { Image } from 'emdash/ui';
import { getLinkPreview } from '../../lib/link-card';

interface Props {
  url: string;
}

const { url } = Astro.props;

const isExternal = /^https?:\/\//u.test(url);
const internalSlug =
  !isExternal && url.startsWith('/posts/')
    ? decodeURIComponent(url.slice('/posts/'.length).split(/[?#]/u)[0])
    : null;

let title = '';
let description = '';
let image = '';
let internalImage: MediaValue | string | undefined;
let hostname = '';

if (internalSlug) {
  const { entry } = await getEmDashEntry('posts', internalSlug);
  if (entry) {
    title = String(entry.data.title ?? '');
    description = String(entry.data.excerpt ?? '');
    const featured = entry.data.featured_image;
    internalImage =
      typeof featured === 'string' ||
      (typeof featured === 'object' && featured !== null)
        ? (featured as MediaValue | string)
        : undefined;
  }
} else if (isExternal) {
  hostname = new URL(url).hostname.replace(/^www\./u, '');
  const preview = await getLinkPreview(url);
  if (preview) {
    title = preview.title;
    description = preview.description;
    image = preview.image;
  }
}

const faviconUrl = hostname
  ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(hostname)}&sz=64`
  : null;
const label = hostname || 'このサイトの記事';
---

{title ? (
  <a
    class='link-card'
    href={url}
    {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  >
    <span class='link-card-body'>
      <span class='link-card-source'>
        {faviconUrl ? (
          <img
            class='link-card-favicon'
            src={faviconUrl}
            alt=''
            width='16'
            height='16'
            loading='lazy'
          />
        ) : (
          <span class='link-card-badge'>B</span>
        )}
        <span class='link-card-host'>{label}</span>
      </span>
      <span class='link-card-title'>{title}</span>
      {description && <span class='link-card-description'>{description}</span>}
    </span>
    {internalImage ? (
      <span class='link-card-thumbnail'>
        <Image image={internalImage} />
      </span>
    ) : image ? (
      <span class='link-card-thumbnail'>
        <img src={image} alt='' loading='lazy' />
      </span>
    ) : null}
  </a>
) : (
  <p class='link-card-fallback'>
    <a
      href={url}
      {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      {url}
    </a>
  </p>
)}

<style>
  .link-card:link,
  .link-card:visited {
    text-decoration: none;
  }

  .link-card {
    display: flex;
    align-items: stretch;
    gap: var(--spacing-4);
    margin: 1.5em 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .link-card:hover {
    border-color: var(--color-brand);
  }

  .link-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    flex: 1;
    min-width: 0;
    padding: var(--spacing-4);
  }

  .link-card-source {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .link-card-favicon {
    width: 16px;
    height: 16px;
    border-radius: var(--radius);
  }

  .link-card-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font-size: 10px;
    font-weight: 700;
  }

  .link-card-host {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-card-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-heading);
    line-height: var(--leading-snug);
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--transition-fast);
  }

  .link-card:hover .link-card-title {
    color: var(--color-brand);
  }

  .link-card-description {
    font-size: var(--font-size-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .link-card-thumbnail {
    flex-shrink: 0;
    width: 160px;
    background: var(--color-bg-subtle);
  }

  .link-card-thumbnail img,
  .link-card-thumbnail :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
  }

  .link-card-thumbnail :global(figure) {
    height: 100%;
    margin: 0;
  }

  .link-card-fallback {
    word-break: break-all;
  }

  @media (max-width: 640px) {
    .link-card-thumbnail {
      display: none;
    }
  }
</style>
