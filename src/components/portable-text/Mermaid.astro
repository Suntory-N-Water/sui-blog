---
import { renderMermaidSVGAsync } from 'beautiful-mermaid';

export interface Props {
  code: string;
}

const { code } = Astro.props;

const themeOptions = {
  bg: 'transparent',
  fg: 'light-dark(#333333, #ededed)',
  accent: 'light-dark(#0066cc, #64b5ff)',
  muted: 'light-dark(#595959, #b3b3b3)',
  surface: 'light-dark(#f5f5f7, #333333)',
  border: 'light-dark(#dbdbdb, #474747)',
  line: 'light-dark(#dbdbdb, #474747)',
  font: 'var(--font-body)',
  transparent: true,
  padding: 8,
};

let svg: string | null = null;
try {
  svg = await renderMermaidSVGAsync(code, themeOptions);
} catch {
  svg = null;
}
---

<figure class='mermaid-figure'>
  {svg ? (
    <Fragment set:html={svg} />
  ) : (
    <pre class='mermaid-source' set:text={code}></pre>
  )}
</figure>

<style>
  .mermaid-figure {
    margin: 2em 0;
    text-align: center;
  }

  .mermaid-figure :global(svg) {
    max-width: 100%;
    height: auto;
  }

  .mermaid-source {
    margin: 0;
    padding: var(--spacing-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    line-height: 1.6;
    text-align: left;
  }
</style>
