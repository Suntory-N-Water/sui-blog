---
import { PortableText } from 'emdash/ui';
import { ALERT_ICON_PATH, type AlertKind } from '../../lib/github-alert';
import CodeBlock from './CodeBlock.astro';

interface Props {
  kind: AlertKind;
  blocks: unknown[];
}

const { kind, blocks } = Astro.props;

const ALERT_LABEL_JA: Record<AlertKind, string> = {
  note: 'メモ',
  tip: 'ヒント',
  important: '重要',
  warning: '警告',
  caution: '注意',
};

const body = (blocks as Array<Record<string, unknown>>).map((block) => ({
  ...block,
  style: 'normal',
}));
---

<div class={`markdown-alert markdown-alert-${kind}`} dir='auto'>
  <p class='markdown-alert-title'>
    <svg viewBox='0 0 16 16' width='14' height='14' aria-hidden='true'>
      <path d={ALERT_ICON_PATH[kind]}></path>
    </svg>
    {ALERT_LABEL_JA[kind]}
  </p>
  {body.length > 0 && (
    <PortableText value={body} components={{ type: { code: CodeBlock } }} />
  )}
</div>

<style>
  .markdown-alert {
    margin: 0 0 26px;
    padding-left: 18px;
    border-left: 2px solid var(--color-rule-strong);
  }

  .markdown-alert :global(> :last-child) {
    margin-bottom: 0;
  }

  .markdown-alert-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-heading);
    margin-bottom: 2px;
  }

  .markdown-alert-title svg {
    flex-shrink: 0;
    fill: currentColor;
  }

  .markdown-alert :global(p) {
    font-size: 15px;
    line-height: 1.9;
  }
</style>
