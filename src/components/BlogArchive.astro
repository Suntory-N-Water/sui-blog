---
import { getEmDashCollection, getTermsForEntries } from 'emdash';
import ArchiveHead from './ArchiveHead.astro';
import BlogIndex from './BlogIndex.astro';
import BlogRow from './BlogRow.astro';
import Pagination from './Pagination.astro';
import { getReadingTime } from '../utils/reading-time';
import { formatYearMonthJp, getYear, blogDate } from '../utils/format-date';

type BlogsResult = Awaited<ReturnType<typeof getEmDashCollection<'blogs'>>>;
type ArchiveBlog = BlogsResult['entries'][number];
type TagsByEntry = Awaited<ReturnType<typeof getTermsForEntries>>;

interface Props {
  blogs: ArchiveBlog[];
  tagsByEntry: TagsByEntry;
  page: number;
  totalPages: number;
}

const { blogs, tagsByEntry, page, totalPages } = Astro.props;

const yearGroups = new Map<string, ArchiveBlog[]>();
for (const blog of blogs) {
  const year = getYear(blogDate(blog.data)) ?? '不明';
  const group = yearGroups.get(year);
  if (group) {
    group.push(blog);
  } else {
    yearGroups.set(year, [blog]);
  }
}

const firstBlog = blogs[0];
const lastBlog = blogs.at(-1);
const newest = firstBlog ? formatYearMonthJp(blogDate(firstBlog.data)) : null;
const oldest = lastBlog ? formatYearMonthJp(blogDate(lastBlog.data)) : null;
const dateRange =
  newest && oldest
    ? newest === oldest
      ? newest
      : `${newest} — ${oldest}`
    : null;
const sub = dateRange ? `${dateRange} / ${page} ページ目` : `${page} ページ目`;
---

<ArchiveHead title='記事一覧' sub={sub} />

{blogs.length === 0 ? (
  <p class='empty'>まだ記事がありません。</p>
) : (
  Array.from(yearGroups.entries()).map(([year, yearBlogs]) => (
    <section class='year-group'>
      <header class='year'>
        <h2>{year}</h2>
        <span>{yearBlogs.length} 件</span>
      </header>
      <BlogIndex topRule={false}>
        {yearBlogs.map((blog) => (
          <BlogRow
            title={blog.data.title}
            href={`/blog/${blog.id}`}
            date={blogDate(blog.data)}
            readingTime={getReadingTime(blog.data.content)}
            icon={blog.data.featured_image}
            tags={(tagsByEntry.get(blog.data.id) ?? []).map((t) => ({
              slug: t.slug,
              label: t.label,
            }))}
          />
        ))}
      </BlogIndex>
    </section>
  ))
)}

{totalPages > 1 && (
  <Pagination currentPage={page} totalPages={totalPages} basePath='/blog' />
)}

<style>
  .year-group {
    max-width: var(--index-width);
  }

  .year {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 34px 0 6px;
    border-bottom: var(--rule-width) solid var(--color-rule-strong);
  }

  .year h2 {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
  }

  .year span {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    max-width: var(--index-width);
    padding: 40px 0;
    color: var(--color-text-secondary);
    border-top: var(--rule-width) solid var(--color-border);
  }
</style>
