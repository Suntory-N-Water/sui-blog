---
import type { ImageValue } from 'emdash';
import { Image } from 'emdash/ui';
import { formatIndexDate } from '../utils/format-date';

interface Props {
  title: string;
  href: string;
  date?: Date | null;
  readingTime?: number;
  excerpt?: string | null;
  icon?: ImageValue | string | null;
  tags?: Array<{ slug: string; label: string }>;
  headingLevel?: 2 | 3;
}

const {
  title,
  href,
  date,
  readingTime,
  excerpt,
  icon,
  tags,
  headingLevel = 3,
} = Astro.props;
const displayDate = formatIndexDate(date);
const Heading = `h${headingLevel}` as const;
---

<li>
  <article class='row'>
    <div class='row-date'>
      {displayDate && <time datetime={date?.toISOString()}>{displayDate}</time>}
    </div>
    <div class='row-icon-cell'>
      {icon && (
        <Image image={icon} alt='' width={20} height={20} class='row-icon' />
      )}
    </div>
    <div class='row-main'>
      <Heading class='row-title'>
        <a href={href}>{title}</a>
      </Heading>
      {excerpt && <p class='row-excerpt'>{excerpt}</p>}
      {(readingTime || (tags && tags.length > 0)) && (
        <footer class='row-foot'>
          {readingTime && <span class='row-readtime'>{readingTime} 分</span>}
          {tags && tags.length > 0 && (
            <ul class='row-tags' aria-label='タグ'>
              {tags.map((tag) => (
                <li>
                  <a href={`/tags/${tag.slug}`} class='tag'>
                    #{tag.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </footer>
      )}
    </div>
  </article>
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 104px 20px minmax(0, 1fr);
    gap: 0 14px;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .row-icon-cell {
    padding-top: 4px;
  }

  .row-date {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 2.1;
    color: var(--color-text-secondary);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .row-title {
    font-size: 16.5px;
    font-weight: var(--font-weight-heading);
    line-height: 1.7;
    letter-spacing: var(--tracking-snug);
  }

  .row-title a {
    color: inherit;
  }

  .row-title a:hover {
    color: var(--color-brand);
  }

  .row-icon-cell :global(.row-icon) {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .row-excerpt {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.85;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .row-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin-top: 7px;
  }

  .row-readtime {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    list-style: none;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-brand);
  }

  .tag:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 20px minmax(0, 1fr);
      gap: 6px 14px;
    }

    .row-date {
      grid-column: 1 / -1;
      line-height: 1.6;
    }

    .row-icon-cell {
      grid-column: 1;
      padding-top: 5px;
    }

    .row-main {
      grid-column: 2;
    }
  }
</style>
