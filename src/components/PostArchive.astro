---
import ArchiveHead from './ArchiveHead.astro';
import PostIndex from './PostIndex.astro';
import PostRow from './PostRow.astro';
import Pagination from './Pagination.astro';
import { type Post, postPath, postTags, readingMinutes } from '../lib/posts';
import { formatYearMonthJp, getYear } from '../utils/format-date';

interface Props {
  posts: Post[];
  page: number;
  totalPages: number;
}

const { posts, page, totalPages } = Astro.props;

const yearGroups = new Map<string, Post[]>();
for (const post of posts) {
  const year = getYear(post.data.date) ?? '不明';
  const group = yearGroups.get(year);
  if (group) {
    group.push(post);
  } else {
    yearGroups.set(year, [post]);
  }
}

const newest = formatYearMonthJp(posts[0]?.data.date);
const oldest = formatYearMonthJp(posts.at(-1)?.data.date);
const dateRange = newest && oldest ? (newest === oldest ? newest : `${newest} — ${oldest}`) : null;
const sub = dateRange ? `${dateRange} / ${page} ページ目` : `${page} ページ目`;
---

<ArchiveHead title='記事一覧' sub={sub} />

{posts.length === 0 ? (
  <p class='empty'>まだ記事がありません。</p>
) : (
  Array.from(yearGroups.entries()).map(([year, yearPosts]) => (
    <section class='year-group'>
      <header class='year'>
        <h2>{year}</h2>
        <span>{yearPosts.length} 件</span>
      </header>
      <PostIndex topRule={false}>
        {yearPosts.map((post) => (
          <PostRow
            title={post.data.title}
            href={postPath(post)}
            date={post.data.date}
            readingTime={readingMinutes(post.body)}
            iconUrl={post.data.icon_url}
            tags={postTags(post)}
          />
        ))}
      </PostIndex>
    </section>
  ))
)}

{totalPages > 1 && <Pagination currentPage={page} totalPages={totalPages} basePath='/posts' />}

<style>
  .year-group {
    max-width: var(--index-width);
  }

  .year {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 34px 0 6px;
    border-bottom: var(--rule-width) solid var(--color-rule-strong);
  }

  .year h2 {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
  }

  .year span {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    max-width: var(--index-width);
    padding: 40px 0;
    color: var(--color-text-secondary);
    border-top: var(--rule-width) solid var(--color-border);
  }
</style>
