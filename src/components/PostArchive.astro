---
import { getEmDashCollection, getTermsForEntries } from 'emdash';
import ArchiveHead from './ArchiveHead.astro';
import PostIndex from './PostIndex.astro';
import PostRow from './PostRow.astro';
import { getReadingTime } from '../utils/reading-time';
import { formatYearMonthJp, getYear, postDate } from '../utils/format-date';

type PostsResult = Awaited<ReturnType<typeof getEmDashCollection<'posts'>>>;
type ArchivePost = PostsResult['entries'][number];
type TagsByEntry = Awaited<ReturnType<typeof getTermsForEntries>>;

interface Props {
  posts: ArchivePost[];
  tagsByEntry: TagsByEntry;
  page: number;
  hasMore: boolean;
}

const { posts, tagsByEntry, page, hasMore } = Astro.props;

const yearGroups = new Map<string, ArchivePost[]>();
for (const post of posts) {
  const year = getYear(postDate(post.data)) ?? '不明';
  const group = yearGroups.get(year);
  if (group) {
    group.push(post);
  } else {
    yearGroups.set(year, [post]);
  }
}

const firstPost = posts[0];
const lastPost = posts.at(-1);
const newest = firstPost ? formatYearMonthJp(postDate(firstPost.data)) : null;
const oldest = lastPost ? formatYearMonthJp(postDate(lastPost.data)) : null;
const dateRange =
  newest && oldest
    ? newest === oldest
      ? newest
      : `${newest} — ${oldest}`
    : null;
const sub = dateRange ? `${dateRange} / ${page} ページ目` : `${page} ページ目`;

const prevHref =
  page > 1 ? (page === 2 ? '/blog' : `/blog/page/${page - 1}`) : null;
const nextHref = hasMore ? `/blog/page/${page + 1}` : null;
---

<ArchiveHead title='記事一覧' sub={sub} />

{posts.length === 0 ? (
  <p class='empty'>まだ記事がありません。</p>
) : (
  Array.from(yearGroups.entries()).map(([year, yearPosts]) => (
    <section class='year-group'>
      <header class='year'>
        <h2>{year}</h2>
        <span>{yearPosts.length} 件</span>
      </header>
      <PostIndex topRule={false}>
        {yearPosts.map((post) => (
          <PostRow
            title={post.data.title}
            href={`/blog/${post.id}`}
            date={postDate(post.data)}
            readingTime={getReadingTime(post.data.content)}
            icon={post.data.featured_image}
            tags={(tagsByEntry.get(post.data.id) ?? []).map((t) => ({
              slug: t.slug,
              label: t.label,
            }))}
          />
        ))}
      </PostIndex>
    </section>
  ))
)}

{(prevHref || nextHref) && (
  <nav class='pager' aria-label='ページ送り'>
    <span class='pager-link pager-prev'>
      {prevHref && <a href={prevHref}>← 前のページ</a>}
    </span>
    <span class='pager-current'>{page}</span>
    <span class='pager-link pager-next'>
      {nextHref && <a href={nextHref}>次のページ →</a>}
    </span>
  </nav>
)}

<style>
  .year-group {
    max-width: var(--index-width);
  }

  .year {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 34px 0 6px;
    border-bottom: 1px solid var(--color-rule-strong);
  }

  .year h2 {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
  }

  .year span {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    max-width: var(--index-width);
    padding: 40px 0;
    color: var(--color-text-secondary);
    border-top: 1px solid var(--color-border);
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--index-width);
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--color-rule-strong);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .pager-link {
    min-width: 96px;
  }

  .pager-next {
    text-align: right;
  }

  .pager-link a {
    color: var(--color-text-secondary);
  }

  .pager-link a:hover {
    color: var(--color-brand);
  }

  .pager-current {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
