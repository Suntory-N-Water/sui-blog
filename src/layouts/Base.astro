---
import { Font } from 'astro:assets';
import {
  GA_MEASUREMENT_ID,
  GOOGLE_SITE_VERIFICATION,
  SITE_TAGLINE,
  SITE_TITLE,
  siteOrigin,
} from '../lib/site';
import '../styles/tokens.css';
import '../styles/theme.css';

interface Props {
  title: string;
  description?: string | null;
  image?: string | null;
  canonical?: string | null;
  robots?: string | null;
  type?: 'website' | 'article';
  publishedTime?: string | null;
  modifiedTime?: string | null;
  markdownHref?: string | null;
}

const {
  title,
  description,
  image,
  canonical,
  robots,
  type = 'website',
  publishedTime,
  modifiedTime,
  markdownHref,
} = Astro.props;
const origin = siteOrigin(Astro.site);
const siteTitle = SITE_TITLE;
const siteTagline = SITE_TAGLINE;
const ogImage = image ?? `${origin}/opengraph-image.png`;
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const canonicalUrl = canonical ?? `${origin}${Astro.url.pathname.replace(/\.html$/u, '')}`;
const metaDescription = description ?? siteTagline;
---

<!doctype html>
<html lang='ja' class='site-root'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <Font cssVariable='--font-latin' preload />
    <Font cssVariable='--font-jp' />
    <Font cssVariable='--font-mono-latin' />
    <title>{fullTitle}</title>
    <meta name='google-site-verification' content={GOOGLE_SITE_VERIFICATION} />
    <meta name='description' content={metaDescription} />
    {robots && <meta name='robots' content={robots} />}
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={metaDescription} />
    <meta name='twitter:image' content={ogImage} />
    <meta property='og:type' content={type} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={metaDescription} />
    <meta property='og:image' content={ogImage} />
    <meta property='og:url' content={canonicalUrl} />
    <meta property='og:site_name' content={siteTitle} />
    <meta property='og:locale' content='ja_JP' />
    {publishedTime && <meta property='article:published_time' content={publishedTime} />}
    {modifiedTime && <meta property='article:modified_time' content={modifiedTime} />}
    <link rel='canonical' href={canonicalUrl} />
    <link rel='icon' href='/favicon.ico' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.jpg' />
    <link rel='alternate' type='application/rss+xml' title={siteTitle} href='/rss.xml' />
    {markdownHref && <link rel='alternate' type='text/markdown' href={markdownHref} />}
    <slot name='head' />
    <script is:inline>
      (() => {
        const theme = document.cookie.match(/(?:^|;\s*)theme=([^;]*)/)?.[1];
        if (theme === 'dark' || theme === 'light') {
          document.documentElement.classList.add(theme);
        }
      })();
    </script>
    {import.meta.env.PROD && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
        ></script>
        <script is:inline define:vars={{ measurementId: GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', measurementId);
        </script>
      </>
    )}
  </head>
  <body>
    <header class='site-header'>
      <nav class='nav' aria-label='サイト'>
        <a href='/' class='site-title'>
          {siteTitle}
        </a>
        <div class='nav-right'>
          <search class='site-search-area'>
            <form class='site-search' action='/search' method='get' role='search' data-site-search>
              <input
                type='search'
                name='q'
                placeholder='記事を検索'
                aria-label='記事を検索'
                autocomplete='off'
                class='site-search-input'
                data-site-search-input
              />
              <div class='site-search-results' hidden data-site-search-results></div>
            </form>
          </search>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class='site-footer'>
      <div class='footer-inner'>
        <div class='footer-grid'>
          <div class='footer-brand'>
            <a href='/' class='footer-logo'>
              {siteTitle}
            </a>
            <p class='footer-tagline'>{siteTagline}</p>
          </div>
          <nav class='footer-nav' aria-labelledby='footer-pages-heading'>
            <h2 class='footer-heading' id='footer-pages-heading'>
              ページ
            </h2>
            <ul class='footer-links'>
              <li>
                <a href='/'>ホーム</a>
              </li>
              <li>
                <a href='/posts'>記事一覧</a>
              </li>
              <li>
                <a href='/tags'>タグ一覧</a>
              </li>
              <li>
                <a href='/search'>記事を検索</a>
              </li>
            </ul>
          </nav>
          <nav class='footer-nav' aria-labelledby='footer-links-heading'>
            <h2 class='footer-heading' id='footer-links-heading'>
              リンク
            </h2>
            <ul class='footer-links'>
              <li>
                <a href='/rss.xml'>RSS</a>
              </li>
            </ul>
          </nav>
        </div>
        <div class='footer-bottom'>
          <div class='theme-switcher' role='group' aria-label='表示テーマ'>
            <button type='button' class='theme-btn' data-theme='light' aria-label='ライトテーマ'>
              <svg
                aria-hidden='true'
                width='16'
                height='16'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
              >
                <circle cx='12' cy='12' r='5'></circle>
                <line x1='12' y1='1' x2='12' y2='3'></line>
                <line x1='12' y1='21' x2='12' y2='23'></line>
                <line x1='4.22' y1='4.22' x2='5.64' y2='5.64'></line>
                <line x1='18.36' y1='18.36' x2='19.78' y2='19.78'></line>
                <line x1='1' y1='12' x2='3' y2='12'></line>
                <line x1='21' y1='12' x2='23' y2='12'></line>
                <line x1='4.22' y1='19.78' x2='5.64' y2='18.36'></line>
                <line x1='18.36' y1='5.64' x2='19.78' y2='4.22'></line>
              </svg>
            </button>
            <button type='button' class='theme-btn' data-theme='dark' aria-label='ダークテーマ'>
              <svg
                aria-hidden='true'
                width='16'
                height='16'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
              >
                <path d='M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z'></path>
              </svg>
            </button>
            <button
              type='button'
              class='theme-btn'
              data-theme='system'
              aria-label='システム設定に合わせる'
            >
              <svg
                aria-hidden='true'
                width='16'
                height='16'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
              >
                <rect x='2' y='3' width='20' height='14' rx='2' ry='2'></rect>
                <line x1='8' y1='21' x2='16' y2='21'></line>
                <line x1='12' y1='17' x2='12' y2='21'></line>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const THEME_REGEX = /(?:^|;\s*)theme=([^;]*)/;
      const themeBtns = document.querySelectorAll<HTMLButtonElement>('.theme-btn');
      const root = document.documentElement;

      function setCookie(name: string, value: string, maxAge: number = 31536000) {
        const secure = location.protocol === 'https:' ? '; Secure' : '';
        if (value === '') {
          document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
        } else {
          document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
        }
      }

      function applyTheme(theme: string) {
        root.classList.remove('light', 'dark');
        if (theme === 'light' || theme === 'dark') {
          root.classList.add(theme);
        }
        updateActiveBtn(theme);
      }

      function setTheme(theme: string) {
        setCookie('theme', theme === 'system' ? '' : theme);
        applyTheme(theme);
      }

      function updateActiveBtn(theme: string) {
        themeBtns.forEach((btn) => {
          const active = btn.dataset.theme === theme;
          btn.classList.toggle('active', active);
          btn.setAttribute('aria-pressed', String(active));
        });
      }

      function getStoredTheme(): string {
        const value = document.cookie.match(THEME_REGEX)?.[1];
        return value === 'light' || value === 'dark' ? value : 'system';
      }

      applyTheme(getStoredTheme());

      themeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          setTheme(btn.dataset.theme || 'system');
        });
      });
    </script>
    <style is:global>
      @layer base;

      @layer base {
        :where(.site-root) *,
        :where(.site-root) *::before,
        :where(.site-root) *::after {
          box-sizing: border-box;
        }

        :where(.site-root)
          :is(body, h1, h2, h3, h4, h5, h6, p, ul, ol, figure, blockquote, dl, dd) {
          margin: 0;
        }

        :where(.site-root) :is(ul, ol) {
          padding: 0;
        }
        @supports (color: light-dark(#000, #fff)) {
          :root:where(.site-root).light {
            color-scheme: light;
          }

          :root:where(.site-root).dark {
            color-scheme: dark;
          }
        }

        :where(.site-root) {
          scroll-behavior: smooth;
        }

        :where(.site-root) body {
          font-family: var(--font-body);
          font-size: var(--font-size-base);
          line-height: var(--leading-relaxed);
          color: var(--color-text);
          background: var(--color-bg);
          -webkit-font-smoothing: antialiased;
          -moz-osx-font-smoothing: grayscale;
          min-height: 100vh;
        }

        :where(.site-root) a {
          color: var(--color-brand);
          text-decoration: none;
          transition: color var(--transition-fast);
        }

        :where(.site-root) a:hover {
          color: var(--color-brand-hover);
        }

        :where(.site-root) img {
          max-width: 100%;
          height: auto;
          display: block;
        }

        :where(.site-root) :is(h1, h2, h3, h4, h5, h6) {
          font-family: var(--font-heading);
          line-height: var(--leading-tight);
          font-weight: var(--font-weight-heading);
          letter-spacing: var(--tracking-snug);
        }

        :where(.site-root) h1 {
          font-weight: var(--font-weight-display);
          letter-spacing: var(--tracking-tight);
        }

        :where(.site-root) ::selection {
          background: var(--color-brand);
          color: var(--color-on-brand);
        }
      }
    </style>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: color-mix(in srgb, var(--color-bg) 65%, transparent);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: var(--rule-width) solid var(--color-border-subtle);
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: var(--wide-width);
        margin: 0 auto;
        padding: var(--spacing-4) var(--spacing-6);
        height: var(--nav-height);
      }

      .site-title {
        font-size: var(--font-size-lg);
        font-weight: 600;
        color: var(--color-text);
        text-decoration: none;
        letter-spacing: var(--tracking-snug);
      }

      .site-title:hover {
        color: var(--color-brand);
      }

      .nav-right {
        display: flex;
        align-items: center;
        gap: var(--spacing-6);
        margin-inline-start: auto;
      }

      .site-search {
        position: relative;
        width: var(--search-input-width);
      }

      :global(.site-search-input) {
        width: var(--search-input-width);
        padding: var(--spacing-2) var(--spacing-3);
        font-family: var(--font-body);
        font-size: var(--font-size-sm);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        background: var(--color-bg);
        color: var(--color-text);
        transition:
          border-color var(--transition-fast),
          box-shadow var(--transition-fast);
      }

      :global(.site-search-input)::placeholder {
        color: var(--color-muted);
      }

      :global(.site-search-input):focus,
      :global(.site-search-input):focus-visible {
        outline: none;
        border-color: var(--color-brand) !important;
        box-shadow: 0 0 0 3px var(--color-brand-ring);
      }

      :global(.site-search-results) {
        position: absolute;
        top: 100%;
        right: 0;
        width: min(360px, calc(100vw - 32px));
        margin-top: var(--spacing-2);
        background: var(--color-bg);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        max-height: 400px;
        overflow-y: auto;
        z-index: 1000;
      }

      :global(.site-search-results[hidden]) {
        display: none;
      }

      :global(.site-search-status) {
        padding: var(--spacing-4);
        text-align: center;
        color: var(--color-muted);
        font-size: var(--font-size-sm);
      }

      :global(.site-search-result) {
        display: block;
        padding: var(--spacing-3) var(--spacing-4);
        text-decoration: none;
        color: var(--color-text);
        border-bottom: var(--rule-width) solid var(--color-border-subtle);
        transition: background var(--transition-fast);
      }

      :global(.site-search-result):last-child {
        border-bottom: none;
      }

      :global(.site-search-result):hover,
      :global(.site-search-result):focus-visible {
        background: var(--color-surface);
        outline: none;
      }

      :global(.site-search-result-title) {
        display: block;
        font-weight: 500;
        font-size: var(--font-size-sm);
      }

      :global(.site-search-result-snippet) {
        display: block;
        font-size: var(--font-size-sm);
        color: var(--color-muted);
        margin-top: var(--spacing-1);
        line-height: var(--leading-snug);
      }

      :global(.site-search-result-snippet mark) {
        background: none;
        font-weight: 600;
        color: var(--color-text);
      }

      main {
        min-height: calc(100vh - var(--nav-height) - 300px);
      }

      /* Footer */
      .site-footer {
        background: var(--color-bg-subtle);
        border-top: var(--rule-width) solid var(--color-border-subtle);
      }

      .footer-inner {
        max-width: var(--wide-width);
        margin: 0 auto;
        padding: var(--spacing-16) var(--spacing-6) var(--spacing-8);
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: var(--spacing-12);
        margin-bottom: var(--spacing-12);
      }

      .footer-brand {
        max-width: 280px;
      }

      .footer-logo {
        font-size: var(--font-size-lg);
        font-weight: 600;
        color: var(--color-text);
        text-decoration: none;
        letter-spacing: var(--tracking-snug);
      }

      .footer-tagline {
        margin-top: var(--spacing-3);
        font-size: var(--font-size-sm);
        color: var(--color-muted);
        line-height: var(--leading-relaxed);
      }

      .footer-nav {
        min-width: 0;
      }

      .footer-heading {
        font-size: var(--font-size-xs);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: var(--tracking-wider);
        color: var(--color-muted);
        margin-bottom: var(--spacing-4);
      }

      .footer-links {
        list-style: none;
      }

      .footer-links li {
        margin-bottom: var(--spacing-2);
      }

      .footer-links a {
        color: var(--color-text-secondary);
        text-decoration: none;
        font-size: var(--font-size-sm);
        transition: color var(--transition-fast);
      }

      .footer-links a:hover {
        color: var(--color-text);
      }

      .footer-bottom {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        padding-top: var(--spacing-6);
        border-top: var(--rule-width) solid var(--color-border);
      }

      /* Theme switcher */
      .theme-switcher {
        display: flex;
        gap: var(--spacing-1);
        padding: var(--spacing-1);
        background: var(--color-surface);
        border-radius: var(--radius);
      }

      .theme-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 28px;
        background: transparent;
        border: none;
        color: var(--color-muted);
        border-radius: var(--radius);
        cursor: pointer;
        transition: all var(--transition-fast);
      }

      .theme-btn:hover {
        color: var(--color-text-secondary);
      }

      .theme-btn.active {
        background: var(--color-bg);
        color: var(--color-text);
        box-shadow: var(--shadow-sm);
      }

      .theme-btn svg {
        width: 16px;
        height: 16px;
      }

      @media (max-width: 900px) {
        .footer-grid {
          grid-template-columns: 1fr 1fr;
          gap: var(--spacing-8);
        }

        .footer-brand {
          grid-column: span 2;
          max-width: none;
        }
      }

      @media (max-width: 640px) {
        .site-header {
          position: relative;
          border-bottom: none;
        }

        .nav {
          display: grid;
          grid-template-columns: auto minmax(0, 1fr) auto;
          align-items: center;
          height: auto;
          column-gap: var(--spacing-3);
          row-gap: var(--spacing-2);
          padding: var(--spacing-3) var(--spacing-4);
        }

        .site-title {
          grid-column: 1;
          grid-row: 1;
          font-size: var(--font-size-base);
          white-space: nowrap;
        }

        .nav-right {
          display: contents;
        }

        .site-search-area {
          grid-column: 2;
          grid-row: 1;
          justify-self: end;
          width: min(100%, 220px);
          min-width: 0;
        }

        .site-search {
          width: 100%;
          max-width: none;
        }

        :global(.site-search-input) {
          width: 100% !important;
          font-size: var(--font-size-sm) !important;
        }

        .footer-grid {
          grid-template-columns: 1fr;
        }

        .footer-brand {
          grid-column: span 1;
        }

        .footer-bottom {
          flex-direction: column;
          gap: var(--spacing-4);
          text-align: center;
        }
      }
    </style>

    <script>
      import { searchPosts } from '../scripts/pagefind';

      const SEARCH_DELAY_MS = 200;
      const RESULT_LIMIT = 6;

      const form = document.querySelector<HTMLFormElement>('[data-site-search]');
      const input = document.querySelector<HTMLInputElement>('[data-site-search-input]');
      const results = document.querySelector<HTMLElement>('[data-site-search-results]');

      function status(message: string) {
        const p = document.createElement('p');
        p.className = 'site-search-status';
        p.textContent = message;
        return p;
      }

      if (form && input && results) {
        let timer: number | undefined;
        let latest = 0;

        const close = () => {
          results.hidden = true;
          results.replaceChildren();
        };

        input.addEventListener('input', () => {
          window.clearTimeout(timer);
          const query = input.value.trim();
          if (!query) {
            close();
            return;
          }
          timer = window.setTimeout(async () => {
            const request = ++latest;
            results.hidden = false;
            results.replaceChildren(status('検索しています'));
            try {
              const found = await searchPosts(query, RESULT_LIMIT);
              if (request !== latest) {
                return;
              }
              if (found.length === 0) {
                results.replaceChildren(status('一致する記事がありません'));
                return;
              }
              results.replaceChildren(
                ...found.map((item) => {
                  const link = document.createElement('a');
                  link.className = 'site-search-result';
                  link.href = item.url;
                  const title = document.createElement('span');
                  title.className = 'site-search-result-title';
                  title.textContent = item.title;
                  const snippet = document.createElement('span');
                  snippet.className = 'site-search-result-snippet';
                  snippet.innerHTML = item.excerpt;
                  link.append(title, snippet);
                  return link;
                }),
              );
            } catch {
              if (request === latest) {
                results.replaceChildren(status('検索できませんでした'));
              }
            }
          }, SEARCH_DELAY_MS);
        });

        input.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            close();
          }
        });

        document.addEventListener('click', (event) => {
          if (!form.contains(event.target as Node)) {
            close();
          }
        });

        document.addEventListener('keydown', (event) => {
          if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
            event.preventDefault();
            input.focus();
          }
        });
      }
    </script>
  </body>
</html>
