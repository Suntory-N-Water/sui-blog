{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Grep",
      "Glob",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(jq:*)",
      "Bash(pinact run:*)",
      "Bash(actionlint:*)",
      "Bash(ghalint run:*)",
      "Bash(zizmor:*)",
      "Bash(agent-browser:*)",
      "Skill(managing-git-github-workflow)",
      "Skill(agent-browser)",
      "Bash(pnpm list:*)",
      "Bash(python3:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(.env)",
      "Read(.dev.vars)",
      "Edit(.env*)",
      "Bash(wget:*)",
      "NotebookEdit"
    ],
    "ask": ["Bash(rm:*)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run --silent -i ~/.claude/scripts/typescript/multi-command-check.ts -c format,lint:ai,type-check:ai"
          },
          {
            "type": "command",
            "command": "bun run --silent -i ~/.claude/scripts/typescript/fix-brackets.ts"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "plansDirectory": ".claude/plans"
}
