{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sui-blog",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "suntory-n-water.com",
      "custom_domain": true
    },
    {
      "pattern": "www.suntory-n-water.com",
      "custom_domain": true
    }
  ]
}
